{
  "name": "shop-republik-ch",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "concurrently \"next dev\" \"pnpm run gql:types --watch\" \"panda --watch\"",
    "build": "panda && pnpm run gql:types && next build",
    "prepare": "panda codegen",
    "start": "next start",
    "lint": "next lint",
    "gql:types": "graphql-codegen --config graphql/configs/codegen-dev.ts",
    "test": "NODE_ENV=test playwright test --project 'Mobile Chrome'",
    "test:ui": "NODE_ENV=test playwright test --project 'Mobile Chrome' --ui",
    "test:generate": "pnpm exec playwright codegen ",
    "yaproxy:staging": "CORS_ORIGIN=http://localhost:3000 PORT=5010 TARGET=https://api.republik.love yaproxy",
    "knip": "knip"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@sentry/nextjs": "^10.78.0",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "@urql/core": "^6.0.3",
    "graphql": "^16.14.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.563.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "next-plausible": "^3.12.5",
    "next-themes": "^0.4.6",
    "qr": "^0.5.5",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "urql": "^5.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.3.1",
    "@next/env": "^16.4.3",
    "@pandacss/dev": "^1.12.1",
    "@parcel/watcher": "^2.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "imapflow": "^1.7.8",
    "knip": "^5.88.1",
    "nanoid": "^5.1.16",
    "typescript": "^5.9.3",
    "yaproxy": "^1.0.2"
  },
  "packageManager": "pnpm@12.14.0"
}
